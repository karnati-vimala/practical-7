
@model FeedbackManagement.Models.Feedback

@{
    ViewBag.Title = "Feedback Form";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Feedback Management</h2>

@using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <p>Name</p>
    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })

    <p>Email</p>
    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })

    <p>Rating</p>
    @Html.DropDownListFor(m => m.Rating,
        new SelectList(new[] { "5", "4", "3", "2", "1" }),
        "-- Select Rating --",
        new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger" })

    <p>Comments</p>
    @Html.TextAreaFor(m => m.Comments,
        new { @class = "form-control", rows = 4 })
    @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger" })

    <br />

    <button type="submit" class="btn btn-primary">Submit Feedback</button>
}
