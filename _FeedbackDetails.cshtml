
@model FeedbackManagement.Models.Feedback

<div class="card" style="padding: 15px; margin-bottom: 15px; border: 1px solid #ddd;">
    <h3>@Model.Name</h3>

    <p>
        <strong>Email:</strong> @Model.Email
    </p>

    <p>
        <strong>Rating:</strong> @Model.Rating / 5
    </p>

    <p>
        <strong>Comments:</strong> @Model.Comments
    </p>
</div>
